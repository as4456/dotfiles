# Managed by chezmoi. Edit with `chezmoi edit ~/.zshrc`.
#
# Prompt is starship, not Powerlevel10k. The p10k instant-prompt block that used to sit
# at the top of this file is gone along with it; starship needs no instant-prompt hack
# because it does not do the work that made one necessary.

# ---------------------------------------------------------------- PATH bootstrap
# This must come first, and it is not optional.
#
# zsh does NOT read ~/.profile — that is a bash/sh file — so the PATH entries set up
# there never reach a zsh login shell. Without this block, ~/.local/bin and the mise
# shims are absent, which means starship, nvim, fzf and zoxide are all missing. Every
# line below that uses them is guarded with `command -v`, so they would skip in
# silence and you would get a bare `hostname%` prompt with no error explaining why.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ---------------------------------------------------------------- oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"

# Empty on purpose: starship owns the prompt. Setting a theme here would render one
# prompt and then have starship overwrite it on every redraw.
ZSH_THEME=""

# asdf's oh-my-zsh plugin is deliberately absent — mise replaces it, and running both
# means two shim directories competing to own `node` and `python` on PATH.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ---------------------------------------------------------------- toolchain
# mise owns node, uv, neovim, starship, fzf, ripgrep, fd, lazygit and zoxide, so every
# tool referenced further down this file becomes available only after this line runs.
#
# Called by absolute path, mirroring what ~/.bashrc does. `command -v mise` would be a
# chicken-and-egg test: mise is what puts its own shims on PATH.
[ -x "$HOME/.local/bin/mise" ] && eval "$("$HOME/.local/bin/mise" activate zsh)"

# ---------------------------------------------------------------- environment
export COLORTERM=truecolor
export EDITOR=nvim
export VISUAL=nvim

# Neovim comes from mise, so no /opt/nvim-* on PATH. The old entry pointed at
# /opt/nvim-linux64, a directory name upstream renamed to nvim-linux-x86_64.
alias vim="nvim"
alias vi="nvim"

# ---------------------------------------------------------------- clipboard
# Under WSL, clip.exe reaches the Windows clipboard with no X server involved. xclip
# needs WSLg running and only ever touches the Linux clipboard.
if command -v clip.exe >/dev/null 2>&1; then
  alias pbcopy="clip.exe"
  alias pbpaste="powershell.exe -NoProfile -Command Get-Clipboard | tr -d '\r'"
elif command -v xclip >/dev/null 2>&1; then
  alias pbcopy="xclip -selection clipboard"
  alias pbpaste="xclip -selection clipboard -o"
fi

# ---------------------------------------------------------------- fzf
# No `alias fd=fdfind`: mise installs the upstream binary under its real name, `fd`.
# The alias existed because Debian and Ubuntu rename it — but an alias never applied
# here anyway, since fzf runs FZF_DEFAULT_COMMAND through sh, where aliases do not
# exist. That mismatch is why fzf silently found nothing on Linux.
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

  _fzf_compgen_path() { fd --hidden --exclude .git . "$1"; }
  _fzf_compgen_dir()  { fd --type=d --hidden --exclude .git . "$1"; }
fi

export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline"

# Current fzf ships its own shell integration; ~/.fzf.zsh was the old install method.
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# Guarded, unlike the version this replaces — an unguarded source here threw on every
# shell start for anyone who had not cloned the repo.
[ -f "$HOME/fzf-git.sh/fzf-git.sh" ] && source "$HOME/fzf-git.sh/fzf-git.sh"

# ---------------------------------------------------------------- navigation
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"

# ---------------------------------------------------------------- completions
# oh-my-zsh already runs compinit; calling it twice only costs startup time.
if ! typeset -f compinit >/dev/null; then
  autoload -Uz compinit && compinit
fi

# ---------------------------------------------------------------- history
HISTSIZE=50000
SAVEHIST=50000
HISTFILE="$HOME/.zsh_history"
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY

# ---------------------------------------------------------------- prompt
# Last, so nothing can overwrite it.
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
